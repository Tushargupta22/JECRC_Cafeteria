# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection URI
# Leave empty or set to 'memory' to use auto-provisioned MongoDB Memory Server
# Or set to your local or Atlas URI: mongodb://127.0.0.1:27017/cafetarea
MONGODB_URI=memory

# JWT Secret Key
JWT_SECRET=super_secret_jwt_key_cafetarea_2026_jecrc

# JWT Expiration Time
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL)
CLIENT_URL=http://localhost:5173

# Authorized Admin Access Key (Set in Vercel / server environment variables)
ADMIN_ACCESS_KEY=your_secure_admin_access_key_here

# Initial Owner Provisioning (Server-side environment variables only)
OWNER_USERNAME=owner
OWNER_DEFAULT_PASSWORD=your_initial_owner_password_here
OWNER_EMAIL=owner@jecrc.edu

# Cloudinary Image Storage (Required for persistent serverless uploads on Vercel)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

